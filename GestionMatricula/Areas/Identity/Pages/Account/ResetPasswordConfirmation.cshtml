@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Confirmación de restablecimiento";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .custom-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-top: 20px;
    }

    .welcome-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #000000;
        margin-top: 20px;
        margin-bottom: 35px;
    }

    .custom-card {
        background-color: var(--institucional-teal);
        border-radius: 12px;
        padding: 40px 50px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .btn-accion {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border: none;
        padding: 12px 45px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        display: block;
        transition: background-color 0.2s ease;
    }

        .btn-accion:hover {
            background-color: #5c2210;
        }
</style>

<div class="custom-container container">
    <div class="text-center">
        <h2 class="welcome-title">Contraseña Restablecida</h2>
    </div>

    <div class="d-flex justify-content-center mb-5">
        <div class="custom-card text-center">
            <p class="text-white fs-5 mb-4">
                Su contraseña ha sido restablecida con éxito.
            </p>

            <div class="mt-4 mb-2">
                <a asp-page="./Login" class="btn-accion text-center">Iniciar Sesión</a>
            </div>
        </div>
    </div>
</div>