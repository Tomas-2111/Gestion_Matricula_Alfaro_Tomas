@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidó su contraseña?";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .custom-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-top: 20px;
    }

    .welcome-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #000000;
        margin-top: 20px;
        margin-bottom: 35px;
    }

    .custom-card {
        background-color: var(--institucional-teal);
        border-radius: 12px;
        padding: 40px 50px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

        .custom-card .form-label {
            color: #ffffff;
            font-weight: bold;
            font-size: 1rem;
            margin-bottom: 10px;
        }

        .custom-card .form-control {
            border-radius: 10px;
            height: 48px;
            border: none;
            font-size: 1rem;
            padding-left: 15px;
        }

    .btn-accion {
        background-color: var(--institucional-brown);
        color: #ffffff;
        border: none;
        padding: 12px 45px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 500;
        transition: background-color 0.2s ease;
    }

        .btn-accion:hover {
            background-color: #5c2210;
            color: #ffffff;
        }

    .link {
        color: #ffffff;
        text-decoration: underline;
        font-size: 0.95rem;
    }

        .link:hover {
            color: #e0e0e0;
        }
</style>

<div class="custom-container container">
    <div class="text-center">
        <h2 class="welcome-title">Recuperación de Contraseña</h2>
    </div>

    <div class="d-flex justify-content-center mb-5">
        <div class="custom-card">
            <p class="text-white text-center mb-4">
                Ingrese su correo electrónico registrado para restablecer su contraseña.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Input.Email" class="text-warning small"></span>
                </div>

                <div class="text-center mt-5 mb-3">
                    <button type="submit" class="btn-accion w-100">Restablecer Contraseña</button>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="./Login" class="link">Volver al inicio de sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}