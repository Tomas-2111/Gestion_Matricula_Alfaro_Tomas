@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmación de recuperación";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .custom-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-top: 20px;
    }

    .welcome-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #000000;
        margin-top: 20px;
        margin-bottom: 35px;
    }

    .custom-card {
        background-color: var(--institucional-teal);
        border-radius: 12px;
        padding: 40px 50px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .btn-accion {
        background-color: var(--institucional-brown);
        color: #ffffff;
        border: none;
        padding: 12px 35px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.2s ease;
    }

        .btn-accion:hover {
            background-color: #5c2210;
            color: #ffffff;
        }
</style>

<div class="custom-container container">
    <div class="text-center">
        <h2 class="welcome-title">Solicitud Enviada</h2>
    </div>

    <div class="d-flex justify-content-center mb-5">
        <div class="custom-card text-center text-white">
            <h4 class="mb-3 fw-bold">Revise su correo</h4>
            <p class="mb-4">
                Hemos enviado un enlace a su dirección de correo electrónico para restablecer su contraseña.
            </p>
            <div class="mt-4">
                <a asp-page="./Login" class="btn-accion">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>