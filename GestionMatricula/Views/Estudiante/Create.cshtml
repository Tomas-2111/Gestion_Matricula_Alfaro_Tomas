@model GestionMatricula.Models.Estudiante

@{
    ViewData["Title"] = "Registro de Estudiante";
    Layout = "_Layout";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid var(--institucional-teal);
        background-color: #ffffff;
    }

    .box-header {
        background-color: var(--institucional-teal);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input {
        border-radius: 12px !important;
        border: 1px solid #000000;
        padding: 10px 15px;
    }

    .custom-input-disabled {
        border-radius: 12px !important;
        border: 1px solid #ccc;
        padding: 10px 15px;
        background-color: #e9ecef;
    }

    .btn-guardar-proto {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 45px;
        font-weight: 500;
        border: none;
        transition: opacity 0.2s ease;
    }

        .btn-guardar-proto:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="container mt-4">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Registro de Estudiante</h1>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Completa tus Datos
                </div>
                <div class="p-4">
                    <form id="formCreateEstudiante" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="CarreraId" id="CarreraId" />
                        <span id="errCarreraId" class="text-danger small d-none mb-3 d-block"></span>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Carrera Seleccionada</label>
                            <input class="form-control custom-input-disabled" value="@ViewBag.NombreCarrera" readonly />
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombre" id="Nombre" class="form-control custom-input" placeholder="Ingrese su nombre completo" maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <span id="errNombre" class="text-danger small d-none"></span>
                        </div>

                        <div class="row align-items-end mb-3">
                            <div class="col-md-7 form-group mb-3 mb-md-0">
                                <label asp-for="Cedula" class="form-label fw-bold">Cédula / Identificación</label>
                                <input asp-for="Cedula" id="Cedula" class="form-control custom-input" placeholder="Ingrese su número de cédula" maxlength="20" />
                                <span asp-validation-for="Cedula" class="text-danger"></span>
                                <span id="errCedula" class="text-danger small d-none"></span>
                            </div>
                            <div class="col-md-5 text-end">
                                <button type="submit" id="btnSubmit" class="btn btn-guardar-proto">Guardar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {

            $("#Nombre").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errNombre").text("El nombre es obligatorio.").removeClass("d-none");
                } else if (valor.length > 100) {
                    $("#errNombre").text("El nombre no puede exceder los 100 caracteres.").removeClass("d-none");
                } else {
                    $("#errNombre").addClass("d-none");
                }
            });

            $("#Cedula").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errCedula").text("La cédula es obligatoria.").removeClass("d-none");
                } else if (valor.length > 20) {
                    $("#errCedula").text("La cédula no puede exceder los 20 caracteres.").removeClass("d-none");
                } else {
                    $("#errCedula").addClass("d-none");
                }
            });

        
        });
    </script>
}