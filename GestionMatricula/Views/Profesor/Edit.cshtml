@model GestionMatricula.Models.Profesor

@{
    ViewData["Title"] = "Modificar Profesor";
    Layout = "_LayoutPanelAdmin";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid var(--institucional-teal);
        background-color: #ffffff;
    }

    .box-header {
        background-color: var(--institucional-teal);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input {
        border-radius: 12px !important;
        border: 1px solid #000000;
        padding: 10px 15px;
    }

    .btn-guardar-proto {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 0;
        width: 180px;
        font-weight: 500;
        border: none;
        display: block;
    }

    .btn-desactivar-proto {
        background-color: var(--institucional-teal);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 0;
        width: 180px;
        font-weight: 500;
        border: none;
        display: block;
        text-align: center;
        text-decoration: none;
    }

        .btn-guardar-proto:hover, .btn-desactivar-proto:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="container-fluid mt-2">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Modificar Profesor</h1>

    <div class="row">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Modificar
                </div>
                <div class="p-4">
                    <form id="formEditProfesor" asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" id="NombreEdit" class="form-control custom-input" maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <span id="errNombreEdit" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Especialidad" class="form-label fw-bold">Especialidad</label>
                            <input asp-for="Especialidad" id="EspecialidadEdit" class="form-control custom-input" maxlength="100" />
                            <span asp-validation-for="Especialidad" class="text-danger"></span>
                            <span id="errEspecialidadEdit" class="text-danger small d-none"></span>
                        </div>

                        <div class="row align-items-center mb-3">
                            <div class="col-md-7 form-group mb-3 mb-md-0">
                                <label asp-for="GradoAcademico" class="form-label fw-bold">Grado Académico</label>
                                <input asp-for="GradoAcademico" id="GradoAcademicoEdit" class="form-control custom-input" maxlength="100" />
                                <span asp-validation-for="GradoAcademico" class="text-danger"></span>
                                <span id="errGradoAcademicoEdit" class="text-danger small d-none"></span>
                            </div>
                            <div class="col-md-5 d-flex flex-column align-items-end gap-2">
                                <button type="submit" class="btn btn-guardar-proto">Guardar</button>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-desactivar-proto">Eliminar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {

            $("#NombreEdit").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errNombreEdit").text("El nombre es obligatorio.").removeClass("d-none");
                } else if (valor.length > 100) {
                    $("#errNombreEdit").text("El nombre no puede superar los 100 caracteres.").removeClass("d-none");
                } else {
                    $("#errNombreEdit").addClass("d-none");
                }
            });

            $("#EspecialidadEdit").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errEspecialidadEdit").text("La especialidad es obligatoria.").removeClass("d-none");
                } else if (valor.length > 100) {
                    $("#errEspecialidadEdit").text("La especialidad no puede superar los 100 caracteres.").removeClass("d-none");
                } else {
                    $("#errEspecialidadEdit").addClass("d-none");
                }
            });

            $("#GradoAcademicoEdit").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errGradoAcademicoEdit").text("El grado académico es obligatorio.").removeClass("d-none");
                } else if (valor.length > 100) {
                    $("#errGradoAcademicoEdit").text("El grado académico no puede superar los 100 caracteres.").removeClass("d-none");
                } else {
                    $("#errGradoAcademicoEdit").addClass("d-none");
                }
            });

        });
    </script>
}