@using Microsoft.AspNetCore.Identity
@model IEnumerable<GestionMatricula.Models.Carrera>
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Carreras Disponibles";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    /* Permite el scroll vertical si el contenedor principal o el layout están bloqueados */
    body, html {
        overflow-y: auto !important;
        height: auto !important;
    }

    .carreras-wrapper {
        min-height: calc(100vh - 120px);
        overflow-y: visible;
    }

    .carreras-sub-header {
        background-color: var(--institucional-brown);
        color: #ffffff;
        font-weight: bold;
        font-size: 1.3rem;
        letter-spacing: 2px;
        padding: 12px 0;
        text-transform: uppercase;
    }

    .carrera-card {
        border: 2px solid var(--institucional-brown) !important;
        border-radius: 15px !important;
        background-color: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .carrera-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
    }

    .btn-matricular {
        background-color: var(--institucional-teal) !important;
        color: #ffffff !important;
        font-weight: bold;
        font-size: 1.05rem;
        letter-spacing: 1px;
        padding: 10px 35px;
        border-radius: 8px;
        border: none;
        text-transform: uppercase;
        transition: background-color 0.2s ease;
    }

    .btn-matricular:hover {
        background-color: #114f5b !important;
    }
</style>

<div class="carreras-wrapper pb-5">
    <div class="carreras-sub-header text-center mb-4">
        Carreras
    </div>

    <div class="container mb-5">
        @* Alerta de Éxito *@
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
                <strong>@TempData["MensajeExito"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* Alerta de Error / Advertencia *@
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show text-center mb-4" role="alert">
                <strong>@TempData["MensajeError"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row row-cols-1 row-cols-md-3 g-5 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card carrera-card h-100 text-center p-4 d-flex flex-column justify-content-between">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                            <h3 class="card-title text-uppercase mb-3" style="font-weight: 500; font-size: 1.3rem; color: #000000;">
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </h3>

                            <p class="card-text text-muted px-2" style="font-size: 1rem; line-height: 1.5;">
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <a asp-controller="Estudiante" asp-action="Create" asp-route-carreraId="@item.Id" class="btn btn-matricular">
                                    Matricular
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "Estudiante", new { carreraId = item.Id })" class="btn btn-matricular">
                                    Iniciar Sesión para Matricular
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>