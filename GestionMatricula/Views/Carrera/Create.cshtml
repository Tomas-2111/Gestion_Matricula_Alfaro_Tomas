@model GestionMatricula.Models.Carrera

@{
    ViewData["Title"] = "Nueva Carrera";
    Layout = "_LayoutPanelAdmin";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid var(--institucional-teal);
        background-color: #ffffff;
    }

    .box-header {
        background-color: var(--institucional-teal);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input {
        border-radius: 12px !important;
        border: 1px solid #000000;
        padding: 10px 15px;
    }

    .btn-guardar-proto {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 45px;
        font-weight: 500;
        border: none;
        transition: opacity 0.2s ease;
    }

        .btn-guardar-proto:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="container-fluid mt-2">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Nueva Carrera</h1>

    <div class="row">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Nueva Carrera
                </div>
                <div class="p-4">
                    <form id="formCreateCarrera" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" id="Nombre" class="form-control custom-input" maxlength="150" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <span id="errNombre" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <input asp-for="Descripcion" id="Descripcion" class="form-control custom-input" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                            <span id="errDescripcion" class="text-danger small d-none"></span>
                        </div>

                        <div class="row align-items-end mb-3">
                            <div class="col-md-7 form-group mb-3 mb-md-0">
                                <label asp-for="TipoCarrera" class="form-label fw-bold">Tipo de Carrera</label>
                                <input asp-for="TipoCarrera" id="TipoCarrera" class="form-control custom-input" />
                                <span asp-validation-for="TipoCarrera" class="text-danger"></span>
                                <span id="errTipoCarrera" class="text-danger small d-none"></span>
                            </div>
                            <div class="col-md-5 text-end">
                                <button type="submit" id="btnSubmit" class="btn btn-guardar-proto">Guardar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
     
            $("#Nombre").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errNombre").text("El nombre de la carrera es obligatorio.").removeClass("d-none");
                } else if (valor.length > 150) {
                    $("#errNombre").text("El nombre no puede exceder los 150 caracteres.").removeClass("d-none");
                } else {
                    $("#errNombre").addClass("d-none");
                }
            });

          

            $("#TipoCarrera").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errTipoCarrera").text("El tipo de carrera es obligatorio.").removeClass("d-none");
                } else {
                    $("#errTipoCarrera").addClass("d-none");
                }
            });

           
        });
    </script>
}