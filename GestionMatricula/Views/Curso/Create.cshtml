@model GestionMatricula.Models.Curso

@{
    ViewData["Title"] = "Nuevo Curso";
    Layout = "_LayoutPanelAdmin";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid var(--institucional-teal);
        background-color: #ffffff;
    }

    .box-header {
        background-color: var(--institucional-teal);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input {
        border-radius: 12px !important;
        border: 1px solid #000000;
        padding: 10px 15px;
    }

    .btn-guardar-proto {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 45px;
        font-weight: 500;
        border: none;
        transition: opacity 0.2s ease;
    }

        .btn-guardar-proto:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="container-fluid mt-2">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Nuevo Curso</h1>

    <div class="row">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Nuevo Curso
                </div>
                <div class="p-4">
                    <form id="formCreateCurso" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" id="Nombre" class="form-control custom-input" maxlength="150" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <span id="errNombre" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CarreraId" class="form-label fw-bold">Carrera</label>
                            <select asp-for="CarreraId" id="CarreraId" class="form-control custom-input" asp-items="ViewBag.CarreraId">
                                <option value="">-- Seleccione una Carrera --</option>
                            </select>
                            <span asp-validation-for="CarreraId" class="text-danger"></span>
                            <span id="errCarreraId" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ProfesorId" class="form-label fw-bold">Profesor (Opcional)</label>
                            <select asp-for="ProfesorId" id="ProfesorId" class="form-control custom-input" asp-items="ViewBag.ProfesorId">
                                <option value="">-- Seleccione un Profesor --</option>
                            </select>
                            <span asp-validation-for="ProfesorId" class="text-danger"></span>
                        </div>

                        <div class="row align-items-end mb-3">
                            <div class="col-md-7 form-group mb-3 mb-md-0">
                                <label asp-for="Creditos" class="form-label fw-bold">Créditos</label>
                                <input asp-for="Creditos" id="Creditos" type="number" class="form-control custom-input" min="1" max="5" />
                                <span asp-validation-for="Creditos" class="text-danger"></span>
                                <span id="errCreditos" class="text-danger small d-none"></span>
                            </div>
                            <div class="col-md-5 text-end">
                                <button type="submit" id="btnSubmit" class="btn btn-guardar-proto">Guardar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
    
            $("#Nombre").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errNombre").text("El nombre del curso es obligatorio.").removeClass("d-none");
                } else if (valor.length > 150) {
                    $("#errNombre").text("El nombre no puede superar los 150 caracteres.").removeClass("d-none");
                } else {
                    $("#errNombre").addClass("d-none");
                }
            });

            $("#CarreraId").on("change blur", function() {
                var valor = $(this).val();
                if (valor === "" || valor === null) {
                    $("#errCarreraId").text("La carrera del curso es obligatoria.").removeClass("d-none");
                } else {
                    $("#errCarreraId").addClass("d-none");
                }
            });

            $("#Creditos").on("keyup change blur", function() {
                var valor = parseInt($(this).val(), 10);
                if (isNaN(valor)) {
                    $("#errCreditos").text("Los créditos del curso son obligatorios.").removeClass("d-none");
                } else if (valor < 1 || valor > 5) {
                    $("#errCreditos").text("Los créditos deben estar entre 1 y 5.").removeClass("d-none");
                } else {
                    $("#errCreditos").addClass("d-none");
                }
            });

        });
    </script>
}