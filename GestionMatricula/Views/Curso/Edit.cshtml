@model GestionMatricula.Models.Curso

@{
    ViewData["Title"] = "Modificar Curso";
    Layout = "_LayoutPanelAdmin";
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid var(--institucional-teal);
        background-color: #ffffff;
    }

    .box-header {
        background-color: var(--institucional-teal);
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input {
        border-radius: 12px !important;
        border: 1px solid #000000;
        padding: 10px 15px;
    }

    .btn-guardar-proto {
        background-color: var(--institucional-brown);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 0;
        width: 180px;
        font-weight: 500;
        border: none;
        display: block;
    }

    .btn-desactivar-proto {
        background-color: var(--institucional-teal);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 0;
        width: 180px;
        font-weight: 500;
        border: none;
        display: block;
        text-align: center;
        text-decoration: none;
    }

        .btn-guardar-proto:hover, .btn-desactivar-proto:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="container-fluid mt-2">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Modificar Curso</h1>

    <div class="row">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Modificar
                </div>
                <div class="p-4">
                    <form id="formEditCurso" asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" id="NombreEdit" class="form-control custom-input" maxlength="150" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <span id="errNombreEdit" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CarreraId" class="form-label fw-bold">Carrera</label>
                            <select asp-for="CarreraId" id="CarreraIdEdit" class="form-control custom-input" asp-items="ViewBag.CarreraId"></select>
                            <span asp-validation-for="CarreraId" class="text-danger"></span>
                            <span id="errCarreraIdEdit" class="text-danger small d-none"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ProfesorId" class="form-label fw-bold">Profesor</label>
                            <select asp-for="ProfesorId" id="ProfesorIdEdit" class="form-control custom-input" asp-items="ViewBag.ProfesorId">
                                <option value="">-- Sin Asignar --</option>
                            </select>
                            <span asp-validation-for="ProfesorId" class="text-danger"></span>
                        </div>

                        <div class="row align-items-center mb-3">
                            <div class="col-md-7 form-group mb-3 mb-md-0">
                                <label asp-for="Creditos" class="form-label fw-bold">Créditos</label>
                                <input asp-for="Creditos" id="CreditosEdit" type="number" class="form-control custom-input" min="1" max="5" />
                                <span asp-validation-for="Creditos" class="text-danger"></span>
                                <span id="errCreditosEdit" class="text-danger small d-none"></span>
                            </div>
                            <div class="col-md-5 d-flex flex-column align-items-end gap-2">
                                <button type="submit" class="btn btn-guardar-proto">Guardar</button>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-desactivar-proto">Eliminar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {

            $("#NombreEdit").on("keyup blur", function() {
                var valor = $(this).val().trim();
                if (valor === "") {
                    $("#errNombreEdit").text("El nombre del curso es obligatorio.").removeClass("d-none");
                } else if (valor.length > 150) {
                    $("#errNombreEdit").text("El nombre no puede superar los 150 caracteres.").removeClass("d-none");
                } else {
                    $("#errNombreEdit").addClass("d-none");
                }
            });

            $("#CarreraIdEdit").on("change blur", function() {
                var valor = $(this).val();
                if (valor === "" || valor === null) {
                    $("#errCarreraIdEdit").text("La carrera del curso es obligatoria.").removeClass("d-none");
                } else {
                    $("#errCarreraIdEdit").addClass("d-none");
                }
            });

            $("#CreditosEdit").on("keyup change blur", function() {
                var valor = parseInt($(this).val(), 10);
                if (isNaN(valor)) {
                    $("#errCreditosEdit").text("Los créditos del curso son obligatorios.").removeClass("d-none");
                } else if (valor < 1 || valor > 5) {
                    $("#errCreditosEdit").text("Los créditos deben estar entre 1 y 5.").removeClass("d-none");
                } else {
                    $("#errCreditosEdit").addClass("d-none");
                }
            });

          
        });
    </script>
}