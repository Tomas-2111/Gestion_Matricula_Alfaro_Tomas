@model GestionMatricula.Models.Curso

@{
    ViewData["Title"] = "Desactivar Curso";
    Layout = "_LayoutPanelAdmin";
    bool tieneEstudiantes = ViewBag.MensajeError != null || TempData["MensajeError"] != null;
    string mensajeError = ViewBag.MensajeError ?? TempData["MensajeError"]?.ToString();
}

<style>
    :root {
        --institucional-teal: #176B7B;
        --institucional-brown: #782E16;
    }

    .form-box {
        border: 2px solid #e61529;
        background-color: #ffffff;
    }

    .box-header {
        background-color: #e61529;
        color: #ffffff;
        padding: 12px 20px;
        font-size: 1.1rem;
    }

    .custom-input-disabled {
        border-radius: 12px !important;
        border: 1px solid #ccc;
        padding: 10px 15px;
        background-color: #e9ecef;
    }

    .btn-eliminar-proto {
        background-color: #e61529;
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 30px;
        font-weight: 500;
        border: none;
    }

    .btn-cancelar-proto {
        background-color: var(--institucional-teal);
        color: #ffffff !important;
        border-radius: 15px;
        padding: 8px 30px;
        font-weight: 500;
        text-decoration: none;
    }
</style>

<div class="container-fluid mt-2">
    <h1 class="mb-5 fw-bold" style="color: #000000;">Desactivar Curso</h1>

    <div class="row">
        <div class="col-12 col-lg-10">
            <div class="form-box">
                <div class="box-header">
                    Confirmar Desactivación
                </div>
                <div class="p-4">

                    @if (tieneEstudiantes)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            <strong><i class="bi bi-exclamation-triangle-fill"></i> @mensajeError</strong>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            ¿Está seguro de que desea eliminar este registro?
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input class="form-control custom-input-disabled" value="@Model.Nombre" disabled />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Carrera</label>
                        <input class="form-control custom-input-disabled" value="@(Model.Carrera != null ? Model.Carrera.Nombre : "")" disabled />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Profesor</label>
                        <input class="form-control custom-input-disabled" value="@(Model.Profesor != null ? Model.Profesor.Nombre : "Sin Asignar")" disabled />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">Créditos</label>
                        <input class="form-control custom-input-disabled" value="@Model.Creditos" disabled />
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-cancelar-proto">Volver</a>

                            <button type="submit" class="btn btn-eliminar-proto" @(tieneEstudiantes ? "disabled" : "")>
                                Confirmar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>